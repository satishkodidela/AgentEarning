# Copied to the server by setup-server.sh / install.sh (mode 600). Fill in every value.
# Quote values that contain spaces or < >.
EINVOICE_BASE_URL=https://erechnungsbote.de
EINVOICE_DATA_DIR=/var/lib/einvoice
EINVOICE_LEGAL_DIR=/var/lib/einvoice/legal
EINVOICE_CONTACT_EMAIL=kontakt@erechnungsbote.de
# SSL validation files (Namecheap/cPanel put them here); served at /.well-known/…
EINVOICE_WELL_KNOWN_DIR=
# Shared hosting (cPanel): the app redirects http:// page views to https:// itself.
# Leave empty behind Caddy, which already redirects.
EINVOICE_FORCE_HTTPS=
# Generated by setup-server.sh; back it up – without it stored Stripe keys cannot be decrypted.
EINVOICE_SECRET_KEY=

# Transactional e-mail (Brevo SMTP relay; key from Brevo > SMTP & API > SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="E-Rechnungsbote <rechnung@erechnungsbote.de>"

# Stripe App (OAuth install) – see stripe-app/README.md. Leave empty to run without it.
STRIPE_APP_SECRET_KEY=
STRIPE_APP_INSTALL_LINK=
STRIPE_APP_CLIENT_ID=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Paddle Billing – see docs/launch-setup.md, "Paddle billing setup". Leave empty to run without billing.
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Price IDs per plan, comma-separated (the first one is offered at checkout)
PADDLE_PRICES_STARTER=
PADDLE_PRICES_BUSINESS=
