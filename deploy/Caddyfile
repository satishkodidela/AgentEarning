# Caddy obtains and renews the HTTPS certificate automatically.
{$EINVOICE_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 11MB
	}
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy 127.0.0.1:8000
}

www.{$EINVOICE_DOMAIN} {
	redir https://{$EINVOICE_DOMAIN}{uri} permanent
}
